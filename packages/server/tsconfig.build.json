{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo",
    "paths": {
      "@searchgres/protocol": ["../protocol/dist/index.d.ts"],
      "searchgres": ["../core/dist/index.d.ts"]
    }
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.smoke.ts"]
}
