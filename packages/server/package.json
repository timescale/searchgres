{
  "name": "@searchgres/server",
  "version": "0.0.0",
  "private": true,
  "description": "Bun JSON-RPC server for one searchgres index.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "sg": "./dist/bin.js"
  },
  "scripts": {
    "bundle:tokenizer-worker": "bun scripts/bundle-tokenizer-worker.ts",
    "build": "npm run bundle:tokenizer-worker && tsc -p tsconfig.build.json",
    "compile": "npm run bundle:tokenizer-worker && bun build ./src/bin.ts --compile --outfile dist/sg",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo src/tokenizer.worker.generated.cjs",
    "typecheck": "npm run bundle:tokenizer-worker && tsc -p tsconfig.json",
    "test:unit": "npm run bundle:tokenizer-worker && find src -name '*.test.ts' ! -name '*.integration.test.ts' -print0 | xargs -0 bun test",
    "test:db": "npm run compile && bun test ./src/*.integration.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@clack/prompts": "^0.11.0",
    "@huggingface/tokenizers": "^0.1.3",
    "@searchgres/client": "file:../client",
    "@searchgres/protocol": "file:../protocol",
    "gpt-tokenizer": "^3.4.0",
    "postgres": "^3.4.9",
    "searchgres": "file:../core"
  }
}
