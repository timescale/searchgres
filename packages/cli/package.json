{
  "name": "@searchgres/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Bun command router and compiled sg binary.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "sg": "./dist/sg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "test:unit": "find src -name '*.test.ts' -print0 | xargs -0 ../../bun test",
    "compile": "../../bun build ./src/bin.ts --compile --outfile dist/sg",
    "compile:all": "../../bun ../../scripts/compile-targets.ts sg ./src/bin.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@searchgres/client": "workspace:*",
    "@searchgres/filter": "workspace:*",
    "@searchgres/protocol": "workspace:*",
    "commander": "^14.0.0"
  }
}
