{
  "name": "@searchgres/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Direct PostgreSQL CLI and MCP in one compiled searchgres binary.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "bundle:tokenizer-worker": "../../bun scripts/bundle-tokenizer-worker.ts",
    "build": "../../bun run bundle:tokenizer-worker && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo src/tokenizer/tokenizer.worker.generated.cjs",
    "test:unit": "../../bun run bundle:tokenizer-worker && find src -name '*.test.ts' -print0 | xargs -0 ../../bun test",
    "test:db": "../../bun test ./test/*.integration.test.ts",
    "compile": "mkdir -p ../../dist && ../../bun build ./src/bin.ts --compile --outfile ../../dist/searchgres && ../../bun ../../scripts/macos-sign.ts ../../dist/searchgres",
    "compile:all": "../../bun ../../scripts/compile-targets.ts searchgres ./src/bin.ts",
    "typecheck": "../../bun run bundle:tokenizer-worker && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@clack/prompts": "^0.11.0",
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "^14.0.0",
    "gpt-tokenizer": "^3.4.0",
    "postgres": "^3.4.9",
    "searchgres": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}
