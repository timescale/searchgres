{
  "name": "@searchgres/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Bun command router and compiled sg binary.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "sg": "./dist/sg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "compile": "npm run bundle:tokenizer-worker --workspace=@searchgres/server && bun build ./src/bin.ts --compile --outfile dist/sg",
    "compile:all": "bun scripts/compile-all.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@searchgres/client": "file:../client",
    "@searchgres/server": "file:../server",
    "searchgres": "file:../core"
  }
}
