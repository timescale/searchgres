{
  "name": "@searchgres/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Bun command router and compiled searchgres binary.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "test:unit": "find src -name '*.test.ts' -print0 | xargs -0 ../../bun test",
    "compile": "mkdir -p ../../dist && ../../bun build ./src/bin.ts --compile --outfile ../../dist/searchgres && ../../bun ../../scripts/macos-sign.ts ../../dist/searchgres",
    "compile:all": "../../bun ../../scripts/compile-targets.ts searchgres ./src/bin.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@searchgres/client": "workspace:*",
    "@searchgres/filter": "workspace:*",
    "@searchgres/presentation": "workspace:*",
    "@searchgres/protocol": "workspace:*",
    "commander": "^14.0.0"
  }
}
