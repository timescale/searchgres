{
  "name": "@searchgres/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Compiled stdio MCP server for Searchgres.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "find src -name '*.test.ts' -print0 | xargs -0 ../../bun test",
    "compile": "mkdir -p ../../dist && ../../bun build ./src/bin.ts --compile --outfile ../../dist/searchgres-mcp && ../../bun ../../scripts/macos-sign.ts ../../dist/searchgres-mcp",
    "compile:all": "../../bun ../../scripts/compile-targets.ts searchgres-mcp ./src/bin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@searchgres/client": "workspace:*",
    "@searchgres/presentation": "workspace:*",
    "@searchgres/protocol": "workspace:*",
    "commander": "^14.0.0",
    "zod": "^4.4.3"
  }
}
