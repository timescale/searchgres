{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    // Members tagged `@internal` (Index.sql, the Index constructor) are
    // implementation plumbing, not API; keep them out of the published types.
    "stripInternal": true,
    // The tarball ships dist/ only, so a map that merely points at ../src/
    // resolves to nothing for consumers. Embed the sources in the .js.map so
    // stack traces and debuggers still reach TypeScript, and skip .d.ts.map
    // files entirely (they cannot inline and would only dangle).
    "sourceMap": true,
    "inlineSources": true,
    "declarationMap": false,
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test/**"]
}
