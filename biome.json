{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist",
      "!docs/reference/filter-syntax.html",
      "!packages/cli/assets"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "Core must run on Node, Bun, and Deno.",
                  "Deno": "Core must run on Node, Bun, and Deno."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "bun",
                      "bun:*",
                      "jsr:*",
                      "jsr:*/**",
                      "npm:*",
                      "npm:*/**",
                      "http://**",
                      "https://**"
                    ],
                    "message": "Core must remain runtime-neutral; use node: built-ins or standard package imports."
                  },
                  {
                    "group": [
                      "@searchgres/cli",
                      "@searchgres/cli/**",
                      "../cli/**",
                      "../../cli/**"
                    ],
                    "message": "Core never depends on the reference binary."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
