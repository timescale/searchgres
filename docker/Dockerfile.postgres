# PostgreSQL 18 for searchgres development and testing.
#
# Bundles the three extensions searchgres requires:
#   - pgvector      vector / halfvec columns + HNSW index   (from the base image)
#   - pg_textsearch BM25 index and ranking                  (release .deb)
#   - ltree         hierarchical paths                      (ships with Postgres)
#
# Build for the host architecture:
#   docker build -t searchgres-postgres -f docker/Dockerfile.postgres docker/
#
# pg_textsearch publishes PostgreSQL- and architecture-specific Debian packages
# for both amd64 and arm64. Download the matching release archive rather than
# compiling the extension in this image.

ARG PG_MAJOR=18
ARG PGVECTOR_VERSION=0.8.6
ARG PG_TEXTSEARCH_VERSION=1.4.0

FROM docker.io/pgvector/pgvector:${PGVECTOR_VERSION}-pg${PG_MAJOR}-trixie
ARG PG_MAJOR
ARG PG_TEXTSEARCH_VERSION
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && curl -fsSL -o /tmp/pg-textsearch.zip \
      "https://github.com/timescale/pg_textsearch/releases/download/v${PG_TEXTSEARCH_VERSION}/pg-textsearch-v${PG_TEXTSEARCH_VERSION}-pg${PG_MAJOR}-${TARGETARCH}.zip" \
 && unzip -q /tmp/pg-textsearch.zip -d /tmp/pg-textsearch \
 && apt-get install -y --no-install-recommends /tmp/pg-textsearch/*.deb \
 && rm -rf /tmp/pg-textsearch /tmp/pg-textsearch.zip /var/lib/apt/lists/*

# pg_textsearch requires shared_preload_libraries. The sample file is what
# initdb copies into a fresh data directory.
RUN echo "shared_preload_libraries = 'pg_textsearch'" >> /usr/share/postgresql/postgresql.conf.sample
